{
  "name": "dalseshop-functions",
  "description": "Firebase Cloud Functions for DalseShop",
  "scripts": {
    "check": "node --check index.js && node -e \"const f=require('./index.js'); console.log('Functions:', Object.keys(f).sort().join(', '))\"",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "nodemailer": "^9.0.6"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
