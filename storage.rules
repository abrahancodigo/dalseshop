rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function canWriteImages() {
      return request.auth != null
        && (
          request.auth.token.email == 'abrahanramos@gmail.com'
          || (
            firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isActive', true) != false
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'lector')
              in ['superadmin', 'admin', 'escritor']
          )
        );
    }

    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if canWriteImages()
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if canWriteImages();
    }
  }
}
